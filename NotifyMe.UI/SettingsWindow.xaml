<Window x:Class="NotifyMe.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotifyMe Settings" Height="300" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="10">
        <TabControl>
            <TabItem Header="Design">
                <StackPanel Margin="10">
                    <GroupBox Header="Floating Widget Appearance">
                        <StackPanel Margin="5">
                            <TextBlock Text="Opacity (Transparency)" Margin="0,0,0,5"/>
                            <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1.0" 
                                    Value="{Binding Opacity, Mode=TwoWay}" 
                                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                                    ValueChanged="OpacitySlider_ValueChanged"/>
                            <TextBlock Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat=P0}" 
                                       HorizontalAlignment="Right"/>

                            <TextBlock Text="Theme" Margin="0,10,0,5"/>
                            <ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Glass (Modern)"/>
                                <ComboBoxItem Content="Classic (Solid)"/>
                            </ComboBox>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="General">
                <TextBlock Text="General settings coming soon..." Margin="10"/>
            </TabItem>
        </TabControl>
        
        <Button Content="Save &amp; Close" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                Width="100" Height="30" Click="SaveButton_Click"/>
    </Grid>
</Window>
