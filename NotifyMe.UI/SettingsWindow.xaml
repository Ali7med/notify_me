<Window x:Class="NotifyMe.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotifyMe Settings" Height="600" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="WindowBackground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="ControlBackground" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="AccentColor" Color="#4CC2FF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="BorderColor" Color="#3A3A3A"/>

        <!-- TextBlock Style -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        
        <!-- Border Style -->
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <!-- ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="GridRoot" Width="10" Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" Focusable="false">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Background="#444444" BorderThickness="0"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="false"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="false"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Thumb" Property="Background" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl Style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="{StaticResource ControlBackground}" 
                                BorderThickness="0" CornerRadius="6,6,0,0" Margin="2,0,2,0" Padding="20,12">
                            <ContentPresenter ContentSource="Header" 
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Slider Style -->
        <Style TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Name="TrackBackground" Height="4" CornerRadius="2" 
                                    Background="{StaticResource ControlBackground}" VerticalAlignment="Center"/>
                            <Canvas VerticalAlignment="Center" Height="4">
                                <Rectangle Name="PART_SelectionRange" Height="4" 
                                          Fill="{StaticResource AccentColor}" RadiusX="2" RadiusY="2"/>
                            </Canvas>
                            <Track Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="18" Height="18" 
                                                        Fill="{StaticResource AccentColor}" 
                                                        Stroke="#1E1E1E" StrokeThickness="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="#1E1E1E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="20,10">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="20" Height="20" 
                                    Background="{StaticResource ControlBackground}" 
                                    BorderBrush="{StaticResource AccentColor}" 
                                    BorderThickness="2" CornerRadius="4" Margin="0,0,10,0">
                                <TextBlock x:Name="CheckMark" Text="✓" 
                                          FontSize="14" FontWeight="Bold"
                                          Foreground="{StaticResource AccentColor}" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="12,10">
                            <Grid>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"/>
                                <ToggleButton Name="ToggleButton" Focusable="False"
                                            IsChecked="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                            ClickMode="Press"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}">
                                                <TextBlock Text="▼" Foreground="{StaticResource TextSecondary}" 
                                                          HorizontalAlignment="Right" VerticalAlignment="Center" 
                                                          Margin="0,0,10,0" FontSize="10"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup Name="Popup" Placement="Bottom" Focusable="False" AllowsTransparency="True"
                                       IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                                    <Border Background="{StaticResource ControlBackground}" 
                                            BorderBrush="{StaticResource AccentColor}" BorderThickness="1" 
                                            CornerRadius="6" MaxHeight="200">
                                        <ScrollViewer>
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="Border" Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBackground}" CornerRadius="12" 
            BorderThickness="1" BorderBrush="#333333">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.7" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#252525" Padding="25,20" BorderThickness="0,0,0,1" BorderBrush="#333333">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="HeaderTitle" Text="⚙️ Settings" FontSize="22" FontWeight="Bold" 
                                  Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock x:Name="HeaderSubtitle" Text="Customize your NotifyMe experience" FontSize="11" 
                                  Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="CloseButton" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" 
                            Background="Transparent" Foreground="{StaticResource TextSecondary}" 
                            FontSize="18" Width="32" Height="32" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Content -->
            <TabControl Grid.Row="1" Margin="10">
                <!-- Appearance Tab -->
                <TabItem x:Name="TabAppearance" Header="🎨 Appearance">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="30">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Transparency Section -->
                            <Border Grid.Row="0" Background="{StaticResource ControlBackground}" 
                                   CornerRadius="10" Padding="25" BorderBrush="#3A3A3A" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" x:Name="LblTransparency" Text="Widget Transparency" 
                                              FontSize="16" FontWeight="SemiBold" 
                                              Foreground="{StaticResource TextPrimary}"/>

                                    <Grid Grid.Row="2">
                                        <TextBlock Text="Opacity" 
                                                  Foreground="{StaticResource TextSecondary}" 
                                                  FontSize="13"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat=P0}" 
                                                  Foreground="{StaticResource AccentColor}" 
                                                  FontSize="14"
                                                  FontWeight="Bold"
                                                  HorizontalAlignment="Right" 
                                                  VerticalAlignment="Center"/>
                                    </Grid>

                                    <Slider Grid.Row="4" x:Name="OpacitySlider" 
                                           Minimum="0.1" Maximum="1.0" Value="0.8" 
                                           TickFrequency="0.1" 
                                           IsSnapToTickEnabled="True"
                                           ValueChanged="OpacitySlider_ValueChanged"/>

                                    <TextBlock Grid.Row="6" x:Name="LblTransparencyDesc" 
                                              Text="Adjust how transparent the floating widget appears" 
                                              Foreground="{StaticResource TextSecondary}" 
                                              FontSize="12" 
                                              TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                            <!-- Theme Section -->
                            <Border Grid.Row="2" Background="{StaticResource ControlBackground}" 
                                   CornerRadius="10" Padding="25" BorderBrush="#3A3A3A" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" x:Name="LblTheme" Text="Theme Style" 
                                              FontSize="16" FontWeight="SemiBold" 
                                              Foreground="{StaticResource TextPrimary}"/>

                                    <ComboBox Grid.Row="2" x:Name="ThemeComboBox" 
                                             Height="42"
                                             FontSize="13"
                                             SelectionChanged="ThemeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="✨ Glass (Modern &amp; Transparent)"/>
                                        <ComboBoxItem Content="⬛ Classic (Solid Background)"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="4" x:Name="LblThemeDesc" 
                                              Text="Choose your preferred visual style" 
                                              Foreground="{StaticResource TextSecondary}" 
                                              FontSize="12"
                                              TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- Network Tab -->
                <TabItem x:Name="TabNetwork" Header="🌐 Network">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="30">
                            <Border Background="{StaticResource ControlBackground}" 
                                   CornerRadius="10" Padding="25" BorderBrush="#3A3A3A" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" x:Name="LblPingHost" Text="Connectivity Test Server" 
                                              FontSize="16" FontWeight="SemiBold" 
                                              Foreground="{StaticResource TextPrimary}"/>

                                    <TextBox Grid.Row="2" x:Name="PingHostTextBox" 
                                            Height="48" 
                                            VerticalContentAlignment="Center" 
                                            Padding="15" 
                                            Background="#1E1E1E" 
                                            Foreground="White" 
                                            FontSize="14"
                                            BorderThickness="1"
                                            BorderBrush="#3A3A3A">
                                        <TextBox.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>

                                    <TextBlock Grid.Row="4" x:Name="LblPingHostDesc" 
                                              Text="IP address used to check internet connectivity (e.g., 8.8.8.8, 1.1.1.1)" 
                                              Foreground="{StaticResource TextSecondary}" 
                                              FontSize="12"
                                              TextWrapping="Wrap"/>

                                    <TextBlock Grid.Row="6" x:Name="LblQuickSelect" 
                                              Text="Quick Select:" 
                                              FontSize="13"
                                              FontWeight="SemiBold"
                                              Foreground="{StaticResource TextPrimary}"/>

                                    <WrapPanel Grid.Row="8" Orientation="Horizontal">
                                        <Button Content="Google (8.8.8.8)" 
                                               Tag="8.8.8.8" 
                                               Click="SetPingHost_Click" 
                                               Margin="0,0,10,10" 
                                               FontSize="12" 
                                               Padding="15,10" 
                                               Background="#3A3A3A"/>
                                        <Button Content="Cloudflare (1.1.1.1)" 
                                               Tag="1.1.1.1" 
                                               Click="SetPingHost_Click" 
                                               Margin="0,0,10,10" 
                                               FontSize="12" 
                                               Padding="15,10" 
                                               Background="#3A3A3A"/>
                                        <Button Content="OpenDNS (208.67.222.222)" 
                                               Tag="208.67.222.222" 
                                               Click="SetPingHost_Click" 
                                               Margin="0,0,0,10" 
                                               FontSize="12" 
                                               Padding="15,10" 
                                               Background="#3A3A3A"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- Notifications Tab -->
                <TabItem x:Name="TabNotifications" Header="🔔 Notifications">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="30">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Notification Type Section -->
                            <Border Grid.Row="0" Background="{StaticResource ControlBackground}" 
                                   CornerRadius="10" Padding="25" BorderBrush="#3A3A3A" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" x:Name="LblAlertPreferences" Text="Alert Preferences" 
                                              FontSize="16" FontWeight="SemiBold" 
                                              Foreground="{StaticResource TextPrimary}"/>

                                    <!-- Radio Options -->
                                    <StackPanel Grid.Row="2">
                                        <RadioButton x:Name="ToastNotificationRadio" GroupName="NotifType" 
                                                    Content="🪟 Windows Toast Notifications" 
                                                    FontSize="13" 
                                                    Margin="0,0,0,8"
                                                    Checked="ToastNotificationRadio_Checked"/>
                                        <TextBlock x:Name="LblWindowsToastDesc" 
                                                  Text="Use built-in Windows notifications" 
                                                  Foreground="{StaticResource TextSecondary}" 
                                                  FontSize="11.5" 
                                                  TextWrapping="Wrap"
                                                  Margin="28,0,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="4">
                                        <RadioButton x:Name="CustomNotificationRadio" GroupName="NotifType" 
                                                    Content="✨ Custom Notifications" 
                                                    FontSize="13" 
                                                    Margin="0,0,0,8"
                                                    Checked="CustomNotificationRadio_Checked"/>
                                        <TextBlock x:Name="LblCustomNotificationsDesc" 
                                                  Text="Custom notification window with configurable position" 
                                                  Foreground="{StaticResource TextSecondary}" 
                                                  FontSize="11.5" 
                                                  TextWrapping="Wrap"
                                                  Margin="28,0,0,0"/>
                                    </StackPanel>

                                    <!-- Position Selector -->
                                    <StackPanel Grid.Row="6" x:Name="CustomPositionPanel" 
                                               Visibility="Collapsed" 
                                               Margin="28,10,0,0">
                                        <TextBlock x:Name="LblNotificationPosition" 
                                                  Text="Position:" 
                                                  Foreground="{StaticResource TextPrimary}" 
                                                  FontSize="12"
                                                  Margin="0,0,0,10"/>
                                        <ComboBox x:Name="NotificationPositionComboBox" 
                                                 Width="200" 
                                                 Height="42"
                                                 HorizontalAlignment="Left">
                                            <ComboBoxItem Content="⬈ Top Right" Tag="TopRight" IsSelected="True"/>
                                            <ComboBoxItem Content="⬉ Top Left" Tag="TopLeft"/>
                                            <ComboBoxItem Content="⬊ Bottom Right" Tag="BottomRight"/>
                                            <ComboBoxItem Content="⬋ Bottom Left" Tag="BottomLeft"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Toast & Sound Options -->
                            <Border Grid.Row="2" Background="{StaticResource ControlBackground}" 
                                   CornerRadius="10" Padding="25" BorderBrush="#3A3A3A" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Toast Option -->
                                    <StackPanel Grid.Row="0">
                                        <CheckBox x:Name="ToastNotificationsCheckBox" 
                                                 Content="📢 Show Toast Notifications" 
                                                 FontSize="13" 
                                                 Margin="0,0,0,8"/>
                                        <TextBlock x:Name="LblShowToastDesc" 
                                                  Text="Display popup when connection changes" 
                                                  Foreground="{StaticResource TextSecondary}" 
                                                  FontSize="11.5" 
                                                  TextWrapping="Wrap"
                                                  Margin="28,0,0,0"/>
                                    </StackPanel>

                                    <!-- Sound Option -->
                                    <StackPanel Grid.Row="2">
                                        <CheckBox x:Name="SoundNotificationsCheckBox" 
                                                 Content="🔊 Play Sound Alerts" 
                                                 FontSize="13" 
                                                 Margin="0,0,0,8"/>
                                        <TextBlock x:Name="LblPlaySoundDesc" 
                                                  Text="Play audio when connection is lost or restored" 
                                                  Foreground="{StaticResource TextSecondary}" 
                                                  FontSize="11.5" 
                                                  TextWrapping="Wrap"
                                                  Margin="28,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Do Not Disturb Section -->
                            <Border Grid.Row="4" Background="{StaticResource ControlBackground}" 
                                   CornerRadius="10" Padding="25" BorderBrush="#3A3A3A" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" x:Name="LblDoNotDisturb" Text="Do Not Disturb" 
                                              FontSize="16" FontWeight="SemiBold" 
                                              Foreground="{StaticResource TextPrimary}"/>

                                    <!-- Manual Toggle -->
                                    <StackPanel Grid.Row="2">
                                        <CheckBox x:Name="EnableDNDCheckBox" 
                                                 Content="🌙 Do Not Disturb Now" 
                                                 FontSize="13" 
                                                 Margin="0,0,0,8"/>
                                        <TextBlock x:Name="LblDNDNowDesc" 
                                                  Text="Silence all notifications immediately" 
                                                  Foreground="{StaticResource TextSecondary}" 
                                                  FontSize="11.5" 
                                                  TextWrapping="Wrap"
                                                  Margin="28,0,0,0"/>
                                    </StackPanel>

                                    <!-- Schedule Toggle -->
                                    <StackPanel Grid.Row="4">
                                        <CheckBox x:Name="EnableDNDScheduleCheckBox" 
                                                 Content="📅 Scheduled DND" 
                                                 FontSize="13" 
                                                 Margin="0,0,0,8"
                                                 Checked="EnableDNDScheduleCheckBox_Checked"
                                                 Unchecked="EnableDNDScheduleCheckBox_Unchecked"/>
                                        <TextBlock x:Name="LblDNDScheduleDesc" 
                                                  Text="Automatically silence during specific hours" 
                                                  Foreground="{StaticResource TextSecondary}" 
                                                  FontSize="11.5" 
                                                  TextWrapping="Wrap"
                                                  Margin="28,0,0,0"/>
                                    </StackPanel>

                                    <!-- Schedule Controls -->
                                    <StackPanel Grid.Row="6" x:Name="DNDSchedulePanel" 
                                               Visibility="Collapsed" 
                                               Margin="28,10,0,0">
                                        <!-- Start Time -->
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="LblStartTime" 
                                                      Text="Start Time:" 
                                                      VerticalAlignment="Center" 
                                                      Foreground="{StaticResource TextPrimary}" 
                                                      FontSize="12"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <ComboBox x:Name="DNDStartHourCombo" 
                                                         Width="70" 
                                                         Height="38"/>
                                                <TextBlock Text=":" 
                                                          VerticalAlignment="Center" 
                                                          FontSize="15"
                                                          Foreground="{StaticResource TextPrimary}"
                                                          Margin="10,0"/>
                                                <ComboBox x:Name="DNDStartMinuteCombo" 
                                                         Width="70" 
                                                         Height="38"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- End Time -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="LblEndTime" 
                                                      Text="End Time:" 
                                                      VerticalAlignment="Center" 
                                                      Foreground="{StaticResource TextPrimary}" 
                                                      FontSize="12"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <ComboBox x:Name="DNDEndHourCombo" 
                                                         Width="70" 
                                                         Height="38"/>
                                                <TextBlock Text=":" 
                                                          VerticalAlignment="Center" 
                                                          FontSize="15"
                                                          Foreground="{StaticResource TextPrimary}"
                                                          Margin="10,0"/>
                                                <ComboBox x:Name="DNDEndMinuteCombo" 
                                                         Width="70" 
                                                         Height="38"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Tip Box -->
                            <Border Grid.Row="6" Background="#2A2A3A" 
                                   CornerRadius="8" 
                                   Padding="20" 
                                   BorderThickness="1" 
                                   BorderBrush="{StaticResource AccentColor}">
                                <StackPanel>
                                    <TextBlock x:Name="LblTipTitle" 
                                              Text="💡 Tip" 
                                              FontSize="13" 
                                              FontWeight="Bold" 
                                              Foreground="{StaticResource AccentColor}" 
                                              Margin="0,0,0,8"/>
                                    <TextBlock x:Name="LblTipBody" 
                                              Text="You can enable both toast notifications and sound alerts for comprehensive feedback, or choose just one based on your preference." 
                                              TextWrapping="Wrap" 
                                              Foreground="{StaticResource TextSecondary}" 
                                              FontSize="11.5"
                                              LineHeight="17"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- Advanced Tab -->
                <TabItem x:Name="TabAdvanced" Header="⚙️ Advanced">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10" Padding="5">
                        <StackPanel Margin="20">
                            <!-- Update Interval Section -->
                            <TextBlock x:Name="LblUpdateFrequency" Text="Update Frequency" 
                                      FontSize="15" FontWeight="SemiBold" 
                                      Foreground="{StaticResource TextPrimary}" 
                                      Margin="0,5,0,12"/>
                            
                            <Border Background="{StaticResource ControlBackground}" 
                                   CornerRadius="8" Padding="20" Margin="0,0,0,25">
                                <StackPanel>
                                    <TextBlock x:Name="LblUpdateFrequencyDesc" 
                                              Text="How often the widget updates network statistics (lower = more responsive, higher = less CPU usage)" 
                                              Foreground="{StaticResource TextSecondary}" 
                                              FontSize="11" 
                                              TextWrapping="Wrap" 
                                              Margin="0,0,0,15"/>
                                    
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Interval (Seconds)" 
                                                  Foreground="{StaticResource TextSecondary}" 
                                                  FontSize="12"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ElementName=UpdateIntervalSlider, Path=Value, StringFormat={}{0}s}" 
                                                  Foreground="{StaticResource AccentColor}" 
                                                  FontSize="13"
                                                  FontWeight="SemiBold"
                                                  HorizontalAlignment="Right" 
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                    
                                    <Slider x:Name="UpdateIntervalSlider" 
                                           Minimum="1" Maximum="10" Value="1" 
                                           TickFrequency="1" 
                                           IsSnapToTickEnabled="True"
                                           Margin="0,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Traffic Threshold Section -->
                            <TextBlock x:Name="LblTrafficThreshold" Text="High Traffic Alert Threshold" 
                                      FontSize="15" FontWeight="SemiBold" 
                                      Foreground="{StaticResource TextPrimary}" 
                                      Margin="0,5,0,12"/>
                            
                            <Border Background="{StaticResource ControlBackground}" 
                                   CornerRadius="8" Padding="20" Margin="0,0,0,25">
                                <StackPanel>
                                    <TextBlock x:Name="LblTrafficThresholdDesc" 
                                              Text="Threshold for considering traffic as 'high' (shows alert when exceeded)" 
                                              Foreground="{StaticResource TextSecondary}" 
                                              FontSize="11" 
                                              TextWrapping="Wrap"
                                              Margin="0,0,0,15"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBox x:Name="TrafficThresholdTextBox" 
                                                Height="45" 
                                                VerticalContentAlignment="Center" 
                                                Padding="15,0" 
                                                Background="#1E1E1E" 
                                                Foreground="White" 
                                                FontSize="13"
                                                BorderThickness="0" 
                                                Margin="0,0,15,0">
                                            <TextBox.Resources>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                        
                                        <ComboBox x:Name="TrafficUnitComboBox" 
                                                 Grid.Column="1" 
                                                 Width="90" 
                                                 Height="45">
                                            <ComboBoxItem Content="KB/s"/>
                                            <ComboBoxItem Content="MB/s" IsSelected="True"/>
                                            <ComboBoxItem Content="GB/s"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Language Section -->
                            <TextBlock x:Name="LblLanguage" Text="Language" 
                                      FontSize="15" FontWeight="SemiBold" 
                                      Foreground="{StaticResource TextPrimary}" 
                                      Margin="0,5,0,12"/>
                            
                            <Border Background="{StaticResource ControlBackground}" 
                                   CornerRadius="8" Padding="20" Margin="0,0,0,25">
                                <StackPanel>
                                    <TextBlock x:Name="LblInterfaceLanguage" 
                                              Text="Interface Language" 
                                              Foreground="{StaticResource TextSecondary}" 
                                              FontSize="12" 
                                              Margin="0,0,0,12"/>
                                    
                                    <ComboBox x:Name="LanguageComboBox" 
                                             Height="45" 
                                             Margin="0,0,0,10">
                                        <!-- Items populated dynamically -->
                                    </ComboBox>
                                    
                                    <TextBlock x:Name="LblSelectLanguage" 
                                              Text="Select your preferred interface language" 
                                              Foreground="{StaticResource TextSecondary}" 
                                              FontSize="11" 
                                              TextWrapping="Wrap"
                                              Margin="0,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Startup Section -->
                            <TextBlock x:Name="LblStartupBehavior" Text="Startup Behavior" 
                                      FontSize="15" FontWeight="SemiBold" 
                                      Foreground="{StaticResource TextPrimary}" 
                                      Margin="0,5,0,12"/>
                            
                            <Border Background="{StaticResource ControlBackground}" 
                                   CornerRadius="8" Padding="20" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox x:Name="AutoStartCheckBox" 
                                             Content="🚀 Start with Windows" 
                                             FontSize="13" 
                                             Margin="0,0,0,10"/>
                                    <TextBlock x:Name="LblStartWithWindowsDesc" 
                                              Text="Automatically launch NotifyMe when Windows starts" 
                                              Foreground="{StaticResource TextSecondary}" 
                                              FontSize="11" 
                                              TextWrapping="Wrap"
                                              Margin="32,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#252525" Padding="20" CornerRadius="0,0,12,12" BorderThickness="0,1,0,0" BorderBrush="#333333">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SaveButton" Content="💾 Save Changes" Width="150" Height="40" Click="SaveButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
