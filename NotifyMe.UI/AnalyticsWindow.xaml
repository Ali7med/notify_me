<Window x:Class="NotifyMe.UI.AnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Analytics - Network Monitor" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="Network Analytics" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Detailed analysis of your network usage patterns" FontSize="14" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
        </StackPanel>

        <!-- Time Range Selector -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <RadioButton x:Name="RadioToday" Content="Today" IsChecked="True" 
                        Style="{DynamicResource MaterialDesignTabRadioButton}"
                        Margin="0,0,20,0"
                        Checked="TimeRange_Changed"/>
            <RadioButton x:Name="RadioWeek" Content="This Week" 
                        Style="{DynamicResource MaterialDesignTabRadioButton}"
                        Margin="0,0,20,0"
                        Checked="TimeRange_Changed"/>
            <RadioButton x:Name="RadioMonth" Content="This Month" 
                        Style="{DynamicResource MaterialDesignTabRadioButton}"
                        Margin="0,0,20,0"
                        Checked="TimeRange_Changed"/>
            <RadioButton x:Name="RadioCustom" Content="Custom Range" 
                        Style="{DynamicResource MaterialDesignTabRadioButton}"
                        Checked="TimeRange_Changed"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Summary Cards -->
                <Grid Grid.Row="0" Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Usage Card -->
                    <materialDesign:Card Grid.Column="0" Padding="20" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="TOTAL USAGE" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TotalUsageText" Text="0 GB" FontSize="28" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <materialDesign:PackIcon Kind="TrendingUp" Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock x:Name="TotalUsageTrend" Text="+12% from last period" FontSize="12" Foreground="#4CAF50"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Average Speed Card -->
                    <materialDesign:Card Grid.Column="1" Padding="20" Margin="10,0,10,0">
                        <StackPanel>
                            <TextBlock Text="AVERAGE SPEED" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,10"/>
                            <TextBlock x:Name="AvgSpeedText" Text="0 MB/s" FontSize="28" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <materialDesign:PackIcon Kind="Speedometer" Foreground="#2196F3" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock x:Name="AvgSpeedTrend" Text="Stable" FontSize="12" Foreground="#2196F3"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Peak Speed Card -->
                    <materialDesign:Card Grid.Column="2" Padding="20" Margin="10,0,10,0">
                        <StackPanel>
                            <TextBlock Text="PEAK SPEED" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,10"/>
                            <TextBlock x:Name="PeakSpeedText" Text="0 MB/s" FontSize="28" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <materialDesign:PackIcon Kind="ChartLine" Foreground="#FF9800" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock x:Name="PeakSpeedTime" Text="Not recorded" FontSize="12" Foreground="#FF9800"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Active Time Card -->
                    <materialDesign:Card Grid.Column="3" Padding="20" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="ACTIVE TIME" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,10"/>
                            <TextBlock x:Name="ActiveTimeText" Text="0h 0m" FontSize="28" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <materialDesign:PackIcon Kind="Clock" Foreground="#9C27B0" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock x:Name="ActiveTimeTrend" Text="Daily average" FontSize="12" Foreground="#9C27B0"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>

                <!-- Charts Section -->
                <Grid Grid.Row="1" Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Usage Over Time Chart -->
                    <materialDesign:Card Grid.Column="0" Padding="20" Margin="0,0,15,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="350"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Usage Over Time" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                            <lvc:CartesianChart x:Name="UsageChart" Grid.Row="1"/>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Upload vs Download Pie Chart -->
                    <materialDesign:Card Grid.Column="1" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="300"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Upload vs Download" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                            <lvc:PieChart x:Name="UploadDownloadPie" Grid.Row="1"/>
                            
                            <!-- Legend -->
                            <StackPanel Grid.Row="2" Margin="0,15,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <Ellipse Width="12" Height="12" Fill="#2196F3" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="DownloadLegend" Text="Download: 0 GB" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="12" Height="12" Fill="#4CAF50" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="UploadLegend" Text="Upload: 0 GB" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>
                </Grid>

                <!-- Peak Hours Chart -->
                <materialDesign:Card Grid.Row="2" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="300"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Peak Hours Analysis" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        <lvc:CartesianChart x:Name="PeakHoursChart" Grid.Row="1"/>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
