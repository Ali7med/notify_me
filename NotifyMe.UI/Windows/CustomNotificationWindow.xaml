<Window x:Class="NotifyMe.UI.Windows.CustomNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CustomNotificationWindow" Height="100" Width="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">
    
    <Border CornerRadius="8" BorderThickness="1" BorderBrush="#333333">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2D2D2D" Offset="0"/>
                <GradientStop Color="#1E1E1E" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6"/> <!-- Accent Bar -->
                <ColumnDefinition Width="Auto"/> <!-- Icon -->
                <ColumnDefinition Width="*"/> <!-- Content -->
                <ColumnDefinition Width="30"/> <!-- Close Button -->
            </Grid.ColumnDefinitions>

            <!-- Accent Bar -->
            <Border x:Name="AccentBar" Background="#00A8E8" CornerRadius="8,0,0,8"/>

            <!-- Icon -->
            <TextBlock x:Name="IconText" Text="ℹ️" FontSize="28" 
                       Grid.Column="1" VerticalAlignment="Center" Margin="15,0,15,0"/>

            <!-- Content -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,10">
                <TextBlock x:Name="TitleText" Text="Notification Title" 
                           FontSize="14" FontWeight="SemiBold" Foreground="White" 
                           TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBlock x:Name="MessageText" Text="This is a sample notification message." 
                           FontSize="12" Foreground="#AAAAAA" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Close Button -->
            <Button Grid.Column="3" VerticalAlignment="Top" HorizontalAlignment="Right"
                    Width="24" Height="24" Margin="0,4,4,0"
                    Background="Transparent" BorderThickness="0"
                    Click="CloseButton_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <TextBlock x:Name="CloseText" Text="✕" Foreground="#666666" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="12"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White" TargetName="CloseText"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
