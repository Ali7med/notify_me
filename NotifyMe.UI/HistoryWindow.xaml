<Window x:Class="NotifyMe.UI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network History" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="WindowBackground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="AccentColor" Color="#4CC2FF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#AAAAAA"/>
    </Window.Resources>

    <Border Background="{StaticResource WindowBackground}" CornerRadius="10" BorderThickness="1" BorderBrush="#333333">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Filters -->
                <RowDefinition Height="*"/>    <!-- Data Grid -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="20,15">
                <TextBlock Text="Network History" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" 
                        Background="Transparent" Foreground="{StaticResource TextSecondary}"
                        Click="CloseButton_Click" Margin="0,-5,-10,0" 
                        BorderThickness="0" FontSize="16" Cursor="Hand"/>
            </Grid>

            <!-- Filters -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,0,20,10">
                <TextBlock Text="Date Range:" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="DateRangeComboBox" Width="150" Height="30" SelectionChanged="DateRangeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Last Hour" IsSelected="True"/>
                    <ComboBoxItem Content="Last 24 Hours"/>
                    <ComboBoxItem Content="Last 7 Days"/>
                    <ComboBoxItem Content="Last 30 Days"/>
                    <ComboBoxItem Content="All Time"/>
                </ComboBox>
                <Button Content="Refresh" Click="RefreshButton_Click" Margin="10,0,0,0" Padding="15,5" Background="{StaticResource AccentColor}" Foreground="#1E1E1E" BorderThickness="0" Cursor="Hand"/>
                <TextBlock x:Name="RecordCountText" Text="0 records" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="15,0,0,0"/>
            </StackPanel>

            <!-- Data Grid -->
            <DataGrid x:Name="HistoryDataGrid" Grid.Row="2" Margin="20,0,20,10"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Background="#2D2D2D" Foreground="{StaticResource TextPrimary}"
                      BorderThickness="0" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" CanUserResizeRows="False"
                      AlternatingRowBackground="#252525">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Width="100"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd}}" Width="120"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="100"/>
                    <DataGridTextColumn Header="Download" Binding="{Binding DownloadSpeedFormatted}" Width="120"/>
                    <DataGridTextColumn Header="Upload" Binding="{Binding UploadSpeedFormatted}" Width="120"/>
                    <DataGridTextColumn Header="Ping (ms)" Binding="{Binding LatencyText}" Width="100"/>
                </DataGrid.Columns>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#333333"/>
                        <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="#2D2D2D"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3D3D3D"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <!-- Footer -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20">
                <Button Content="Clear Old Logs (30+ days)" Click="ClearOldLogs_Click" Padding="15,8" Background="#555555" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
