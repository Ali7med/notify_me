<Window x:Class="NotifyMe.UI.FloatingIconWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Monitor" Height="90" Width="90"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseDoubleClick="Window_MouseDoubleClick">
    
    <Window.Resources>
        <Style TargetType="MenuItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <!-- Outer Glow/Shadow -->
        <Border x:Name="GlowBorder" CornerRadius="45" Background="Transparent">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
            </Border.Effect>
        </Border>

        <!-- Main Circle with Gradient Border -->
        <Border x:Name="MainBorder" 
                CornerRadius="45" 
                BorderThickness="2"
                Margin="5">
            <Border.BorderBrush>
                <LinearGradientBrush x:Name="BorderGradient" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#4CC2FF" Offset="0"/>
                    <GradientStop Color="#FFD700" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Background>
                <SolidColorBrush Color="#1E1E1E" Opacity="0.85"/>
            </Border.Background>

            <!-- Content -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="DownloadText" Text="↓ 0.0" 
                           Foreground="#4CC2FF" 
                           FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"
                           HorizontalAlignment="Center" Margin="0,0,0,2">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.5" Color="Black"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="UploadText" Text="↑ 0.0" 
                           Foreground="#FFD700" 
                           FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"
                           HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.5" Color="Black"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Open NotifyMe" Click="MenuItem_Open_Click" FontWeight="Bold"/>
                <Separator/>
                <MenuItem Header="Settings" Click="MenuItem_Settings_Click"/>
                <MenuItem Header="Hide Widget" Click="MenuItem_Hide_Click"/>
                <MenuItem Header="Exit Application" Click="MenuItem_Exit_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</Window>
