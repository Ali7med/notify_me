<Window x:Class="NotifyMe.UI.FloatingIconWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Monitor" Height="70" Width="180"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseDoubleClick="Window_MouseDoubleClick"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
    
    <Window.Resources>
        <Style TargetType="MenuItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <!-- Outer Glow -->
        <Border x:Name="GlowBorder" CornerRadius="10" Background="Transparent" Margin="5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.4" Color="#000000"/>
            </Border.Effect>
        </Border>

        <!-- Main Card -->
        <Border x:Name="MainBorder" 
                CornerRadius="10" 
                BorderThickness="1"
                Margin="5">
            <Border.BorderBrush>
                <SolidColorBrush x:Name="IndicatorBorderBrush" Color="#4CC2FF"/>
            </Border.BorderBrush>
            <Border.Background>
                <SolidColorBrush Color="#0A0A0A" Opacity="0.95"/>
            </Border.Background>

            <Grid Margin="10,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Status Indicator Bar -->
                <Border x:Name="StatusBar" Grid.RowSpan="3" Width="3" CornerRadius="1.5" Background="#4CC2FF" Margin="0,2,8,2">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#4CC2FF" Opacity="0.6"/>
                    </Border.Effect>
                </Border>

                <!-- Speed Stats -->
                <Grid Grid.Column="1" Grid.Row="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Download -->
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 0 0 L 3.5 3.5 L 7 0" Stroke="#4CC2FF" StrokeThickness="1.5" 
                              VerticalAlignment="Center" Margin="0,1,4,0"/>
                        <TextBlock x:Name="DownloadText" Text="0.0 K" 
                                   Foreground="#E0E0E0" 
                                   FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Upload -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Path Data="M 0 3.5 L 3.5 0 L 7 3.5" Stroke="#FFD700" StrokeThickness="1.5" 
                              VerticalAlignment="Center" Margin="0,1,4,0"/>
                        <TextBlock x:Name="UploadText" Text="0.0 K" 
                                   Foreground="#E0E0E0" 
                                   FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Divider -->
                <Border Grid.Row="1" Grid.Column="1" Height="1" Background="#333333" Margin="0,2"/>

                <!-- Ping Stats -->
                <Grid Grid.Column="1" Grid.Row="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PING" Foreground="#888888" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="PingText" Text="-- ms" 
                                   Foreground="#FFFFFF" 
                                   FontSize="11" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Segoe UI"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Open NotifyMe" Click="MenuItem_Open_Click" FontWeight="Bold"/>
                <Separator/>
                <MenuItem Header="Settings" Click="MenuItem_Settings_Click"/>
                <MenuItem Header="Hide Widget" Click="MenuItem_Hide_Click"/>
                <MenuItem Header="Exit Application" Click="MenuItem_Exit_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</Window>
