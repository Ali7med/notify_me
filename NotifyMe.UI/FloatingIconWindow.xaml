    <Window x:Class="NotifyMe.UI.FloatingIconWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Network Monitor" Height="70" Width="180"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseDoubleClick="Window_MouseDoubleClick"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
    
    <Window.Resources>
        <Style TargetType="MenuItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <!-- Outer Glow -->
        <Border x:Name="GlowBorder" CornerRadius="10" Background="Transparent" Margin="5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.4" Color="#000000"/>
            </Border.Effect>
        </Border>

        <!-- Main Card -->
        <Border x:Name="MainBorder" 
                CornerRadius="10" 
                BorderThickness="1"
                Margin="5">
            <Border.BorderBrush>
                <SolidColorBrush x:Name="IndicatorBorderBrush" Color="#4CC2FF"/>
            </Border.BorderBrush>
            <Border.Background>
                <SolidColorBrush Color="#0A0A0A" Opacity="0.95"/>
            </Border.Background>
            
            <Border.ToolTip>
                <ToolTip Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Network Status" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,5"/>
                        <Separator Background="#333333" Margin="0,0,0,5"/>
                        
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Network:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock x:Name="TooltipNetworkName" Text="Unknown" Foreground="#FFFFFF" FontSize="11" Grid.Column="1"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="IP Address:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock x:Name="TooltipIPAddress" Text="Loading..." Foreground="#FFFFFF" FontSize="11" Grid.Column="1"/>
                        </Grid>
                        
                        <Separator Background="#333333" Margin="0,5"/>
                        
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Session DL:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock x:Name="TooltipSessionDownload" Text="0 MB" Foreground="#4CC2FF" FontSize="11" Grid.Column="1"/>
                        </Grid>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Session UL:" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock x:Name="TooltipSessionUpload" Text="0 MB" Foreground="#FFD700" FontSize="11" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </ToolTip>
            </Border.ToolTip>

            <Grid Margin="10,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Mini Chart (Background) -->
                <lvc:CartesianChart x:Name="MiniChart" 
                                   Grid.RowSpan="3" 
                                   Grid.ColumnSpan="2" 
                                   Margin="-5"
                                   Opacity="0.3"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed">
                </lvc:CartesianChart>

                <!-- Status Indicator Bar -->
                <Border x:Name="StatusBar" Grid.RowSpan="3" Width="3" CornerRadius="1.5" Background="#4CC2FF" Margin="0,2,8,2">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#4CC2FF" Opacity="0.6"/>
                    </Border.Effect>
                </Border>

                <!-- Normal View Grid -->
                <Grid x:Name="NormalViewGrid" Grid.Column="1" Grid.RowSpan="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Speed Stats -->
                    <Grid Grid.Row="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Download -->
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 0 0 L 3.5 3.5 L 7 0" Stroke="#4CC2FF" StrokeThickness="1.5" 
                                  VerticalAlignment="Center" Margin="0,1,4,0"/>
                            <TextBlock x:Name="DownloadText" Text="0.0 K" 
                                       Foreground="#E0E0E0" 
                                       FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Upload -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Path Data="M 0 3.5 L 3.5 0 L 7 3.5" Stroke="#FFD700" StrokeThickness="1.5" 
                                  VerticalAlignment="Center" Margin="0,1,4,0"/>
                            <TextBlock x:Name="UploadText" Text="0.0 K" 
                                       Foreground="#E0E0E0" 
                                       FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Divider -->
                    <Border Grid.Row="1" Height="1" Background="#333333" Margin="0,2"/>

                    <!-- Ping Stats -->
                    <Grid Grid.Row="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PING" Foreground="#888888" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="PingText" Text="-- ms" 
                                       Foreground="#FFFFFF" 
                                       FontSize="11" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Compact View Grid (For Circle Mode) -->
                <Grid x:Name="CompactViewGrid" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="3" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="TotalSpeedText" Text="0.0 M" 
                                   Foreground="#FFFFFF" 
                                   FontSize="12" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Segoe UI"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Total" 
                                   Foreground="#AAAAAA" 
                                   FontSize="9" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Open NotifyMe" Click="MenuItem_Open_Click" FontWeight="Bold" Tag="OpenNotifyMe"/>
                <Separator/>
                <MenuItem x:Name="MenuShowMiniChart" Header="Show Mini Chart" IsCheckable="True" Click="MenuItem_ShowMiniChart_Click" Tag="ShowMiniChart"/>
                <MenuItem Header="Widget Shape">
                    <MenuItem Header="Pill (Default)" Tag="Shape_Pill" Click="MenuItem_Shape_Click"/>
                    <MenuItem Header="Square" Tag="Shape_Square" Click="MenuItem_Shape_Click"/>
                    <MenuItem Header="Circle (Compact)" Tag="Shape_Circle" Click="MenuItem_Shape_Click"/>
                </MenuItem>
                <MenuItem Header="Settings" Click="MenuItem_Settings_Click" Tag="Settings"/>
                <Separator/>
                <MenuItem Header="Hide Widget" Click="MenuItem_Hide_Click" Tag="HideWidget"/>
                <MenuItem Header="Exit Application" Click="MenuItem_Exit_Click" Tag="ExitApplication"/>
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</Window>
