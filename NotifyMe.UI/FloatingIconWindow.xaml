<Window x:Class="NotifyMe.UI.FloatingIconWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Monitor" Height="80" Width="80"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseDoubleClick="Window_MouseDoubleClick">
    
    <Window.Resources>
        <Style TargetType="MenuItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="5,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="MainBorder" 
                CornerRadius="40" 
                BorderThickness="2" 
                Background="#CC1E1E1E">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="DownloadText" Text="↓ 0.0" 
                           Foreground="#4CC2FF" 
                           FontSize="11" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,2"/>
                <TextBlock x:Name="UploadText" Text="↑ 0.0" 
                           Foreground="#FFD700" 
                           FontSize="11" FontWeight="Bold" 
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Open NotifyMe" Click="MenuItem_Open_Click" FontWeight="Bold"/>
                <Separator/>
                <MenuItem Header="Hide Widget" Click="MenuItem_Hide_Click"/>
                <MenuItem Header="Exit Application" Click="MenuItem_Exit_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</Window>
